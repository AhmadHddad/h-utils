{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES6",
    "lib": [
      "ES6",
      "DOM"
    ],
    "declaration": true,
    "outDir": "lib",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "lib",
  ]
}